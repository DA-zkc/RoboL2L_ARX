+
+// Deployment bridge: execute the exact library trajectory inspected offline.
+// This exposes existing panda-py control; it does not implement a new controller.
+bool Panda::executeJointTrajectory(std::shared_ptr<motion::JointTrajectory> traj,
+                                  double success_threshold, double settle_timeout,
+                                  bool compensate_coriolis) {
+  trajectory_report_.clear();
+  if (!traj || traj->getDuration() <= 0.0) throw std::runtime_error("Invalid trajectory");
+  stopController();
+  auto state = robot_->readOnce();
+  if (state.current_errors || state.robot_mode != franka::RobotMode::kIdle)
+    throw std::runtime_error("Robot must be idle and error-free");
+  if (automatic_recovery_) throw std::runtime_error("Disable automatic recovery before deployment execution");
+  auto ctrl = std::make_shared<controllers::JointTrajectory>(traj,
+      controllers::JointTrajectory::kDefaultStiffness,
+      controllers::JointTrajectory::kDefaultDamping,
+      controllers::JointTrajectory::kDefaultDqThreshold,
+      controllers::JointTrajectory::kDefaultFilterCoeff, settle_timeout, compensate_coriolis);
+  _startController(ctrl);
+  auto callback = _createTorqueCallback();
+  _runController(callback);
+  // The synchronous bridge must retire its controller too, otherwise
+  // isMoving()/getState() keep returning the final cached control-loop sample.
+  current_controller_->stop(getState(), model_);
+  raiseError();
+  auto end = robot_->readOnce();
+  _setState(end);
+  const double error = (Eigen::Map<const Vector7d>(end.q.data()) - traj->getJointPositions(traj->getDuration())).cwiseAbs().maxCoeff();
+  trajectory_report_ = {{"curve_duration_s", traj->getDuration()}, {"control_duration_s", ctrl->getTime()},
+      {"settled", ctrl->settled() ? 1.0 : 0.0}, {"settle_timeout_s", settle_timeout},
+      {"max_joint_error_rad", error}, {"acceptance_rad", success_threshold},
+      {"coriolis_compensation", compensate_coriolis ? 1.0 : 0.0}};
+  return true;  // Normal device completion; error remains measured feedback.
+}
diff --git a/include/motion/sampled_joint_curve.h b/include/motion/sampled_joint_curve.h
new file mode 100644
--- /dev/null
+++ b/include/motion/sampled_joint_curve.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <stdexcept>
+#include <tuple>
+#include <vector>
+
+// A timestamped reference, not a controller. Coefficients come from a clamped
+// cubic spline over the public trajectory samples. Both installed controllers
+// evaluate this same curve in their existing realtime loop.
+namespace station {
+using Sample = std::array<double, 7>;
+using Polynomial = std::array<Sample, 4>;
+class SampledJointCurve {
+ public:
+  std::vector<Polynomial> coefficients;
+  double dt, duration;
+  SampledJointCurve(const std::vector<Polynomial>& values, double interval)
+      : coefficients(values), dt(interval), duration(values.size()*interval) {
+    if (values.empty() || !std::isfinite(dt) || dt <= 0 || !std::isfinite(duration))
+      throw std::invalid_argument("invalid_sampled_trajectory");
+    for (const auto& row : values) for (const auto& coefficient : row)
+      for (double value : coefficient)
+        if (!std::isfinite(value)) throw std::invalid_argument("nonfinite_trajectory_coefficient");
+  }
+  std::tuple<Sample, Sample, Sample> sample(double time) const {
+    if (!std::isfinite(time)) throw std::invalid_argument("invalid_sample_time");
+    const double t = std::max(0., std::min(duration, time));
+    const size_t i = std::min(coefficients.size()-1, static_cast<size_t>(t/dt));
+    const double local = t-i*dt;
+    const auto& c = coefficients[i];
+    Sample q{}, v{}, a{};
+    for (size_t j=0; j<7; ++j) {
+      q[j]=((c[0][j]*local+c[1][j])*local+c[2][j])*local+c[3][j];
+      v[j]=(3*c[0][j]*local+2*c[1][j])*local+c[2][j];
+      a[j]=6*c[0][j]*local+2*c[1][j];
+    }
+    return {q,v,a};
+  }
+};
+}
